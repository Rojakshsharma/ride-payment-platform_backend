generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRole {
  CUSTOMER
  DRIVER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String

  age          Int
  gender       Gender
  role         UserRole @default(CUSTOMER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}